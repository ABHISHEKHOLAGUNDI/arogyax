# ============================================
# ArogyaX Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================

# --- OpenAI (Worker secrets — set via `npx wrangler secret put`) ---
# OPENAI_API_KEY=sk-...           # Set via: npx wrangler secret put OPENAI_API_KEY
# JWT_SECRET=...                  # Set via: npx wrangler secret put JWT_SECRET

# --- OpenAI Model Configuration ---
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- Frontend (Vite exposes VITE_ prefixed vars) ---
VITE_API_URL=http://localhost:8787
VITE_DEMO_MODE=true

# --- App ---
APP_ENV=development
